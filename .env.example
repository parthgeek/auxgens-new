# Gmail SMTP requires 2-Step Verification and a 16-character app password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@your-domain.com
SMTP_PASS=replace-with-16-character-app-password
SMTP_FROM=Auxgens <contact@your-domain.com>
CONTACT_TO=contact@your-domain.com

# Recommended for production contact-form bot protection:
# https://developers.cloudflare.com/turnstile/get-started/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Comma-separated public origins allowed to submit the contact form.
CONTACT_ALLOWED_ORIGINS=https://auxgens.net,https://www.auxgens.net
